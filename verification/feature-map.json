{
  "version": 1,
  "features": [
    {
      "id": "verification-gate",
      "owner": "Repository maintainer",
      "symptoms": [
        "검증했다고 했지만 실행 증거가 없다",
        "다른 커밋 또는 이전 실행의 로그가 제출됐다",
        "반례나 필수 검사가 빠졌는데 완료로 보고됐다"
      ],
      "entrypoints": [
        {
          "path": "tools/verify_contract.py",
          "navigate": "저장소 루트에서 python tools/verify_contract.py lint 또는 receipt를 실행한다. --help에서 필수 인수를 확인한다."
        },
        {
          "path": "tools/verification_contract.py",
          "navigate": "validate_map / validate_receipt를 읽고 실제 실패 코드와 입력을 대조한다."
        }
      ],
      "refs": [
        "docs/PRODUCT.md#BR-900",
        "docs/PRODUCT.md#WF-900",
        "docs/ARCHITECTURE.md#CMP-900",
        "docs/DATA_FLOW.md#DF-900",
        "specs/verification-gate/ACCEPTANCE.md#AC-900",
        "specs/verification-gate/ACCEPTANCE.md#AC-901",
        "specs/verification-gate/ACCEPTANCE.md#AC-902",
        "specs/verification-gate/ACCEPTANCE.md#AC-903"
      ],
      "checks": [
        {
          "id": "valid-path",
          "kind": "positive",
          "argv": [
            "python",
            "-m",
            "unittest",
            "tests.test_verification_contract.ValidTests",
            "-v"
          ],
          "expected": "정상 지도/증거가 유효하며 JSON 명령은 실행하지 않는다.",
          "covers": [
            "AC-900",
            "AC-901",
            "AC-903"
          ],
          "evidence_types": [
            "log"
          ]
        },
        {
          "id": "negative-cases",
          "kind": "negative",
          "argv": [
            "python",
            "-m",
            "unittest",
            "tests.test_verification_contract.RejectionTests",
            "-v"
          ],
          "expected": "누락·변조·다른 실행·타입 오류·반례 없는 지도를 거부한다.",
          "covers": [
            "AC-900",
            "AC-901",
            "AC-902"
          ],
          "evidence_types": [
            "log"
          ]
        },
        {
          "id": "cli-regression",
          "kind": "regression",
          "argv": [
            "python",
            "-m",
            "unittest",
            "tests.test_verification_contract.CliTests",
            "-v"
          ],
          "expected": "실제 CLI가 dirty/wrong-head/untracked-map/부분 증거를 차단하고 승인 권한을 주지 않는다.",
          "covers": [
            "AC-901",
            "AC-902",
            "AC-903"
          ],
          "evidence_types": [
            "log"
          ]
        },
        {
          "id": "import-boundary",
          "kind": "architecture",
          "argv": [
            "python",
            "-m",
            "unittest",
            "tests.test_verification_contract.ArchitectureTests",
            "-v"
          ],
          "expected": "검증 코어는 승인된 표준 라이브러리만 의존하며 동적 코드 실행을 하지 않는다.",
          "covers": [
            "AC-902",
            "AC-903"
          ],
          "evidence_types": [
            "log"
          ]
        }
      ]
    }
  ]
}
