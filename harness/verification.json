{
  "schema_version": 1,
  "docs_paths": [
    "README.md",
    "docs/*",
    "specs/*",
    ".github/pull_request_template.md"
  ],
  "risk_paths": [
    "AGENTS.md",
    "tools/*",
    "harness/*",
    "tests/*",
    ".github/workflows/*"
  ],
  "checks": {
    "diff": {
      "argv": [
        "git",
        "diff",
        "--check",
        "{base}",
        "--"
      ],
      "timeout_seconds": 30
    },
    "harness-contract": {
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py"
      ],
      "timeout_seconds": 120
    },
    "feature-map": {
      "argv": [
        "{python}",
        "-B",
        "tools/feature_map.py",
        "lint"
      ],
      "timeout_seconds": 30
    },
    "harness-journey": {
      "argv": [
        "{python}",
        "-B",
        "tools/harness_journey.py"
      ],
      "timeout_seconds": 60
    }
  },
  "profiles": {
    "docs": [
      "diff",
      "feature-map"
    ],
    "focused": [
      "diff",
      "feature-map"
    ],
    "full": [
      "diff",
      "feature-map",
      "harness-contract",
      "harness-journey"
    ]
  },
  "features": [
    {
      "id": "harness-verification",
      "paths": [
        "tools/*",
        "harness/*",
        "tests/*",
        "AGENTS.md",
        ".gitignore",
        "specs/harness-verification/*"
      ],
      "symptoms": [
        "과도한 전체 회귀",
        "변경 기능의 검증 누락",
        "실행하지 않은 검사를 통과로 보고",
        "테스트가 너무 많이 돌아요",
        "full regression",
        "임시 실행 환경 재현 실패"
      ],
      "entrypoints": [
        "tools/verify.py:main",
        "tools/verify.py:select",
        "tools/verify.py:execute",
        "tools/feature_map.py:main",
        "tools/harness_journey.py:main"
      ],
      "journey": [
        "feature_map.py lookup --query로 후보 기능과 실제 소스를 찾는다",
        "--base REF --plan으로 선택 이유 확인",
        "--output으로 한 번 실행",
        "receipt.json과 실패 로그 확인"
      ],
      "checks": [
        "harness-contract",
        "feature-map",
        "harness-journey"
      ],
      "failure_probe": "미매핑 변경은 full로 승격하고, 위험 변경을 focused로 낮추려 하면 거부한다.",
      "navigation": {
        "spec": "specs/harness-verification/SPEC.md#BR-H002",
        "environment": "docs/FACTORY_READY.md",
        "tests": [
          "tests/test_verify.py:SelectionTests.test_one_feature_does_not_run_neighbor",
          "tests/test_factory_ready.py:MapTests.test_missing_symbol_blocks",
          "tests/test_factory_ready.py:GuardrailTests.test_navigation_has_no_execution_or_write_dependencies"
        ],
        "acceptance": [
          {
            "ref": "specs/harness-verification/ACCEPTANCE.md#AC-H010",
            "checks": [
              "feature-map",
              "harness-contract"
            ]
          },
          {
            "ref": "specs/harness-verification/ACCEPTANCE.md#AC-H011",
            "checks": [
              "harness-journey"
            ]
          },
          {
            "ref": "specs/harness-verification/ACCEPTANCE.md#AC-H012",
            "checks": [
              "harness-journey",
              "harness-contract"
            ]
          },
          {
            "ref": "specs/harness-verification/ACCEPTANCE.md#AC-H013",
            "checks": [
              "feature-map",
              "harness-contract"
            ]
          }
        ]
      }
    }
  ]
}
